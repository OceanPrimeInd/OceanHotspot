# Copy to .env.local for local dev. Never commit real secrets.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Public site URL — production or staging preview URL (used in emails/links when set in Supabase too)
# NEXT_PUBLIC_SITE_URL=https://www.oceanhotspot.com

# Optional: show "Staging" banner when not production
# NEXT_PUBLIC_APP_ENV=staging

# Optional: staffed support line (shown in header when set)
# NEXT_PUBLIC_SUPPORT_PHONE=+441234567890
# NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=01234 567890

# Customer checkout: false = opening soon (browse + contact only). true = live Stripe checkout.
# NEXT_PUBLIC_CUSTOMER_CHECKOUT_ENABLED=false
# Supabase Edge secret (create-checkout): CUSTOMER_CHECKOUT_ENABLED=true when going live
