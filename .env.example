# Copy to .env.local for local dev. Never commit real secrets.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Public site URL — production or staging preview URL (used in emails/links when set in Supabase too)
# NEXT_PUBLIC_SITE_URL=https://www.oceanhotspot.com

# Optional: show "Staging" banner when not production
# NEXT_PUBLIC_APP_ENV=staging

# Shop switch: false = opening soon (wish list, WhatsApp, email). true = basket + checkout live.
# NEXT_PUBLIC_SHOP_OPEN=false

# WhatsApp Business number (digits only, country code, no +)
# NEXT_PUBLIC_WHATSAPP_NUMBER=447700900123

# Legacy checkout flags (still honoured on edge if SHOP_OPEN unset):
# NEXT_PUBLIC_CUSTOMER_CHECKOUT_ENABLED=false
# Supabase Edge: SHOP_OPEN=true or CUSTOMER_CHECKOUT_ENABLED=true when going live
# OPENING_ALERT_EMAIL=orders@oceanhotspot.com
